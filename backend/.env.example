# Backend environment variables
# Copy to .env and fill in real values. Never commit .env.

# Full SQLAlchemy connection string — should use app_user, not postgres_admin
DATABASE_URL=postgresql://app_user:app_password_change_me@db:5432/mentassist_app

# Passed through from db service for reference
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password_change_me
APP_DB_HOST=db
APP_DB_PORT=5432
POSTGRES_DB=mentassist_app

# JWT secret — fill in before running (required once auth is implemented)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_before_running
